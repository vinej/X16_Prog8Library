    ; -> carry set if the seed stack overflowed
    sub shape_flood(uword x_, uword y_, ubyte col) -> bool {
        %asm {{
        .if BANK_X16_USE_SHAPES
            lda $00
            pha
            lda #BANK_X16_USE_SHAPES
            sta $00
        .endif
            lda p8v_x_
            sta $22
            lda p8v_x_+1
            sta $23
            lda p8v_y_
            sta $24
            lda p8v_y_+1
            sta $25
            lda p8v_col
            jsr x16src.shape_flood
            lda #0
            rol  a
            sta p8v_retbit
        .if BANK_X16_USE_SHAPES
            pla
            sta $00
        .endif
        }}
        return retbit
    }

