        .if BANK_X16_USE_PALETTE
            pla
            sta $00
        .endif
        }}
    }

    ; bulk-load `count` entries from RAM (2 bytes each, low first)
    sub pal_load(uword src, ubyte first, ubyte count) {
        %asm {{
        .if BANK_X16_USE_PALETTE
            lda $00
            pha
            lda #BANK_X16_USE_PALETTE
            sta $00
        .endif
            lda p8v_src
            sta X16_PTR0
            lda p8v_src+1
            sta X16_PTR0+1
            lda p8v_first
            ldx p8v_count
            jsr x16src.pal_load
        .if BANK_X16_USE_PALETTE
            pla
            sta $00
        .endif
        }}
    }

