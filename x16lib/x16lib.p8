            lda p8v_value
            sta $22
            lda p8v_value+1
            sta $23
            jsr x16src.u16_to_dec
            sta p8v_ret16
            stx p8v_ret16+1
        .if BANK_X16_USE_NUMBER
            pla
            sta $00
        .endif
        }}
        return ret16
    }

