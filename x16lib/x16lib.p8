    ; -> r0..r3 = year/month/day/hour/min/sec/jiffy/weekday
    sub clock_get_date_time() {
        %asm {{
        .if BANK_X16_USE_CLOCK
            lda $00
            pha
            lda #BANK_X16_USE_CLOCK
            sta $00
        .endif
            jsr x16src.clock_get_date_time
        .if BANK_X16_USE_CLOCK
            pla
            sta $00
        .endif
        }}
    }

    ; .year1900 is the KERNAL byte value: full year minus 1900.
    sub clock_set_date_time_raw(uword year1900, uword month, uword day, uword hours, uword minutes, uword seconds, uword jiffies, uword weekday) {
        %asm {{
        .if BANK_X16_USE_CLOCK
            lda $00
            pha
            lda #BANK_X16_USE_CLOCK
            sta $00
        .endif
            lda p8v_year1900
            sta $02
            lda p8v_month
            sta $03
            lda p8v_day
            sta $04
            lda p8v_hours
            sta $05
            lda p8v_minutes
            sta $06
            lda p8v_seconds
            sta $07
            lda p8v_jiffies
            sta $08
            lda p8v_weekday
            sta $09
            jsr x16src.clock_set_date_time
        .if BANK_X16_USE_CLOCK
            pla
            sta $00
        .endif
        }}
    }

    ; comms/i2c -> A = value, carry set on NAK/error
    sub i2c_read_byte(ubyte device, ubyte offset) -> bool {
        %asm {{
        .if BANK_X16_USE_I2C
            lda $00
            pha
            lda #BANK_X16_USE_I2C
            sta $00
        .endif
            ldx p8v_device
            ldy p8v_offset
            jsr x16src.i2c_read_byte
            lda #0
            rol  a
            sta p8v_retbit
        .if BANK_X16_USE_I2C
            pla
            sta $00
        .endif
        }}
        return retbit
    }

    ; -> carry set on NAK/error
    sub i2c_write_byte(ubyte value, ubyte device, ubyte offset) -> bool {
        %asm {{
        .if BANK_X16_USE_I2C
            lda $00
            pha
            lda #BANK_X16_USE_I2C
            sta $00
        .endif
            lda p8v_value
            ldx p8v_device
            ldy p8v_offset
            jsr x16src.i2c_write_byte
            lda #0
            rol  a
            sta p8v_retbit
        .if BANK_X16_USE_I2C
            pla
            sta $00
        .endif
        }}
        return retbit
    }

    ; -> carry set on NAK/error
    sub i2c_batch_read(ubyte device, uword buffer, uword count) -> bool {
        %asm {{
        .if BANK_X16_USE_I2C
            lda $00
            pha
            lda #BANK_X16_USE_I2C
            sta $00
        .endif
            lda p8v_buffer
            sta $02
            lda p8v_buffer+1
            sta $02+1
            lda p8v_count
            sta $04
            lda p8v_count+1
            sta $04+1
            ldx p8v_device
            clc
            jsr x16src.i2c_batch_read
            lda #0
            rol  a
            sta p8v_retbit
        .if BANK_X16_USE_I2C
            pla
            sta $00
        .endif
        }}
        return retbit
    }

    ; -> carry set on NAK/error; reads repeatedly into the same address
    sub i2c_batch_read_fixed(ubyte device, uword buffer, uword count) -> bool {
        %asm {{
        .if BANK_X16_USE_I2C
            lda $00
            pha
            lda #BANK_X16_USE_I2C
            sta $00
        .endif
            lda p8v_buffer
            sta $02
            lda p8v_buffer+1
            sta $02+1
            lda p8v_count
            sta $04
            lda p8v_count+1
            sta $04+1
            ldx p8v_device
            sec
            jsr x16src.i2c_batch_read
            lda #0
            rol  a
            sta p8v_retbit
        .if BANK_X16_USE_I2C
            pla
            sta $00
        .endif
        }}
        return retbit
    }

    ; -> r2 = bytes written, carry set on NAK/error
    sub i2c_batch_write(ubyte device, uword buffer, uword count) -> bool {
        %asm {{
        .if BANK_X16_USE_I2C
            lda $00
            pha
            lda #BANK_X16_USE_I2C
            sta $00
        .endif
            lda p8v_buffer
            sta $02
            lda p8v_buffer+1
            sta $02+1
            lda p8v_count
            sta $04
            lda p8v_count+1
            sta $04+1
            ldx p8v_device
            jsr x16src.i2c_batch_write
            lda #0
            rol  a
            sta p8v_retbit
        .if BANK_X16_USE_I2C
            pla
            sta $00
        .endif
        }}
        return retbit
    }

