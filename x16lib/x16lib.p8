    ; -> printable: C clear, A baseline, X width, Y height; control: C set
    sub graph_get_char_size(ubyte char, ubyte style) -> ubyte {
        %asm {{
        .if BANK_X16_USE_GRAPH
            lda $00
            pha
            lda #BANK_X16_USE_GRAPH
            sta $00
        .endif
            lda p8v_char
            ldx p8v_style
            jsr x16src.graph_get_char_size
            sta p8v_ret8
        .if BANK_X16_USE_GRAPH
            pla
            sta $00
        .endif
        }}
        return ret8
    }

    ; -> r0/r1 updated, carry set if outside bounds
    sub graph_put_char(ubyte char, uword x_, uword y_) -> bool {
        %asm {{
        .if BANK_X16_USE_GRAPH
            lda $00
            pha
            lda #BANK_X16_USE_GRAPH
            sta $00
        .endif
            lda p8v_x_
            sta $02
            lda p8v_x_+1
            sta $03
            lda p8v_y_
            sta $04
            lda p8v_y_+1
            sta $05
            lda p8v_char
            jsr x16src.graph_put_char
            lda #0
            rol  a
            sta p8v_retbit
        .if BANK_X16_USE_GRAPH
            pla
            sta $00
        .endif
        }}
        return retbit
    }

