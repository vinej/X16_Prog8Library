    ; storage/mem  (KERNAL block ops; stream to/from VERA_DATA0 too)
    sub mem_fill(uword dst, uword count, ubyte val) {
        %asm {{
        .if BANK_X16_USE_MEM
            lda $00
            pha
            lda #BANK_X16_USE_MEM
            sta $00
        .endif
            lda p8v_dst
            sta $22
            lda p8v_dst+1
            sta $23
            lda p8v_count
            sta $24
            lda p8v_count+1
            sta $25
            lda p8v_val
            jsr x16src.mem_fill
        .if BANK_X16_USE_MEM
            pla
            sta $00
        .endif
        }}
    }

    sub mem_copy(uword src, uword dst, uword count) {
        %asm {{
        .if BANK_X16_USE_MEM
            lda $00
            pha
            lda #BANK_X16_USE_MEM
            sta $00
        .endif
            lda p8v_src
            sta $22
            lda p8v_src+1
            sta $23
            lda p8v_dst
            sta $24
            lda p8v_dst+1
            sta $25
            lda p8v_count
            sta $26
            lda p8v_count+1
            sta $27
            jsr x16src.mem_copy
        .if BANK_X16_USE_MEM
            pla
            sta $00
        .endif
        }}
    }

    ; -> A = CRC low, X = CRC high
    sub mem_crc(uword addr, uword count) -> ubyte {
        %asm {{
        .if BANK_X16_USE_MEM
            lda $00
            pha
            lda #BANK_X16_USE_MEM
            sta $00
        .endif
            lda p8v_addr
            sta $22
            lda p8v_addr+1
            sta $23
            lda p8v_count
            sta $24
            lda p8v_count+1
            sta $25
            jsr x16src.mem_crc
            sta p8v_ret8
        .if BANK_X16_USE_MEM
            pla
            sta $00
        .endif
        }}
        return ret8
    }

    ; -> A/X = one past the last output byte
    sub mem_decompress(uword src, uword dst) -> uword {
        %asm {{
        .if BANK_X16_USE_MEM
            lda $00
            pha
            lda #BANK_X16_USE_MEM
            sta $00
        .endif
            lda p8v_src
            sta $22
            lda p8v_src+1
            sta $23
            lda p8v_dst
            sta $24
            lda p8v_dst+1
            sta $25
            jsr x16src.mem_decompress
            sta p8v_ret16
            stx p8v_ret16+1
        .if BANK_X16_USE_MEM
            pla
            sta $00
        .endif
        }}
        return ret16
    }

