    ; util/zx0 and util/tscrunch -> A/X = one past the last output byte
    sub zx0_decompress(uword src, uword dst) -> uword {
        %asm {{
        .if BANK_X16_USE_ZX0
            lda $00
            pha
            lda #BANK_X16_USE_ZX0
            sta $00
        .endif
            lda p8v_src
            sta $22
            lda p8v_src+1
            sta $23
            lda p8v_dst
            sta $24
            lda p8v_dst+1
            sta $25
            jsr x16src.zx0_decompress
            sta p8v_ret16
            stx p8v_ret16+1
        .if BANK_X16_USE_ZX0
            pla
            sta $00
        .endif
        }}
        return ret16
    }

