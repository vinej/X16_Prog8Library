        %asm {{
        .if BANK_X16_USE_TSC
            lda $00
            pha
            lda #BANK_X16_USE_TSC
            sta $00
        .endif
            lda p8v_src
            sta $22
            lda p8v_src+1
            sta $23
            lda p8v_dst
            sta $24
            lda p8v_dst+1
            sta $25
            jsr x16src.tsc_decompress
        .if BANK_X16_USE_TSC
            pla
            sta $00
        .endif
        }}
    }

