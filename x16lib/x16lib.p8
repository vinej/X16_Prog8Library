    ; util/collide -> carry set if the two boxes overlap (8-bit coordinates and sizes)
    sub collide8(ubyte ax, ubyte ay, ubyte aw, ubyte ah, ubyte bx, ubyte by, ubyte bw, ubyte bh) -> bool {
        %asm {{
        .if BANK_X16_USE_COLLIDE
            lda $00
            pha
            lda #BANK_X16_USE_COLLIDE
            sta $00
        .endif
            lda p8v_ax
            sta $22
            lda p8v_ay
            sta $23
            lda p8v_aw
            sta $24
            lda p8v_ah
            sta $25
            lda p8v_bx
            sta $26
            lda p8v_by
            sta $27
            lda p8v_bw
            sta $28
            lda p8v_bh
            sta $29
            jsr x16src.collide8
            lda #0
            rol  a
            sta p8v_retbit
        .if BANK_X16_USE_COLLIDE
            pla
            sta $00
        .endif
        }}
        return retbit
    }

    ; -> carry set if the two boxes overlap (16-bit; writes cl_* directly)
    sub collide16(uword ax, uword ay, uword aw, uword ah, uword bx, uword by, uword bw, uword bh) -> bool {
        %asm {{
        .if BANK_X16_USE_COLLIDE
            lda $00
            pha
            lda #BANK_X16_USE_COLLIDE
            sta $00
        .endif
            lda p8v_ax
            sta x16src.cl_ax
            lda p8v_ax+1
            sta x16src.cl_ax+1
            lda p8v_ay
            sta x16src.cl_ay
            lda p8v_ay+1
            sta x16src.cl_ay+1
            lda p8v_aw
            sta x16src.cl_aw
            lda p8v_aw+1
            sta x16src.cl_aw+1
            lda p8v_ah
            sta x16src.cl_ah
            lda p8v_ah+1
            sta x16src.cl_ah+1
            lda p8v_bx
            sta x16src.cl_bx
            lda p8v_bx+1
            sta x16src.cl_bx+1
            lda p8v_by
            sta x16src.cl_by
            lda p8v_by+1
            sta x16src.cl_by+1
            lda p8v_bw
            sta x16src.cl_bw
            lda p8v_bw+1
            sta x16src.cl_bw+1
            lda p8v_bh
            sta x16src.cl_bh
            lda p8v_bh+1
            sta x16src.cl_bh+1
            jsr x16src.collide16
            lda #0
            rol  a
            sta p8v_retbit
        .if BANK_X16_USE_COLLIDE
            pla
            sta $00
        .endif
        }}
        return retbit
    }

