    ; -> carry set if the buffer was full
    sub rb_put(ubyte byte_) -> bool {
        %asm {{
        .if BANK_X16_USE_BUFFERS
            lda $00
            pha
            lda #BANK_X16_USE_BUFFERS
            sta $00
